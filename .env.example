# Copy to `.env` and fill in only the providers you actually use.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit it, and never paste a real key into
# `.env.example`. Anything already exported in your shell wins over this file.
#
# Set a spending cap on each key in the provider's dashboard. Storage hygiene
# stops a key leaking; a cap stops a leak or a runaway loop being expensive.

# OpenRouter reaches many vendors with one key. Model names look like
# `openrouter/anthropic/claude-opus-5`. Konkord resolves the vendor behind the
# router, so an OpenRouter judge is still refused if it shares a family with a
# model being ranked.
OPENROUTER_API_KEY=

# Direct provider keys, if you would rather not go through a router.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
